# Public base URL, used to build share links.
APP_URL=http://localhost:3000

# Signs session cookies and seals share tokens at rest.
# Generate with: openssl rand -base64 32
SESSION_SECRET=replace-me

DATABASE_URL=postgres://zema:zema@localhost:5432/zema

# S3-compatible storage. Defaults below match docker-compose (MinIO).
# For Cloudflare R2:
#   S3_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com
#   S3_REGION=auto
#   S3_FORCE_PATH_STYLE=false
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_FORCE_PATH_STYLE=true
S3_BUCKET=zema-deliveries
S3_ACCESS_KEY_ID=zema
S3_SECRET_ACCESS_KEY=zemazema

# Largest single upload, in bytes. 5 GB is the S3 single-PUT ceiling.
MAX_UPLOAD_BYTES=5368709120

# Optional. Without these, share links are copied by hand from the dashboard
# and outgoing mail is logged to the console instead.
# RESEND_API_KEY=
# EMAIL_FROM=deliveries@zemastudios.com
